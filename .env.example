# Maritime Tail Risk Engine: Environment Configuration Example
# Copy to .env for local runtime overrides. NEVER commit production secrets.

# ==============================================================================
# 1. Execution Environment & Storage Isolation
# ==============================================================================
# Execution Environment Mode: 'sandbox' | 'testing' | 'production'
# In 'sandbox' mode, any attempt to access prod_maritime_vintage.db physically raises PermissionError.
MARITIME_ENV_MODE=sandbox

# Database Paths
MARITIME_SQLITE_PATH=data/sandbox_maritime.db
MARITIME_PROD_DB_NAME=prod_maritime_vintage.db

# ==============================================================================
# 2. OSINT Ingestion Hygiene & Spatial Centroids
# ==============================================================================
# Incident deduplication clustering tolerances
DEFAULT_SPATIAL_TOLERANCE_NM=15.0
DEFAULT_TEMPORAL_WINDOW_SECONDS=43200

# Corridor default centroid (Bonny-Brass Fairway approach: 4.2250°N, 7.0850°E)
CENTROID_DEFAULT_LAT=4.2250
CENTROID_DEFAULT_LON=7.0850

# ==============================================================================
# 3. 100% Civilian Multi-Sensor MDA Telemetry Providers (OSINT Only)
# ==============================================================================
# Strictly public civilian telemetry sources (Hard firewall: zero military C2 feeds)
SAR_DARK_VESSEL_PROVIDER=GFW_SENTINEL1_SAR
METOCEAN_PROVIDER=COPERNICUS_ERA5_METOCEAN
AIS_LOITERING_PROVIDER=IMF_PORTWATCH_AIS
THERMAL_FLARING_PROVIDER=NOAA_VIIRS_FIRMS

# ==============================================================================
# 4. Actuarial Tail Risk, MSSA & Underwriting Parameters
# ==============================================================================
# Target percentile for Value-at-Risk & Expected Shortfall (CVaR)
DEFAULT_TAIL_RISK_ALPHA=0.99

# Benchmark container/tanker insured hull & machinery value in USD
INSURED_VESSEL_USD=85000000.0

# Commercial private maritime security company (PMSC) daily armed escort cost
DAILY_ESCORT_COST_USD=18500.0

# Numerical stability guard: GPD shape parameter upper cap (xi <= 0.95 prevents infinite mean)
POT_SHAPE_XI_CAP=0.95

# Peaks-Over-Threshold quantile threshold for residual shock extraction
POT_THRESHOLD_QUANTILE=0.90
